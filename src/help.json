{
  "title": "Tablor",
  "children": [
    {
      "title": "Overview",
      "lines": [
        "2-osc wavetable",
        "synth. 8 voices",
        "poly or mono.",
        "",
        "2 wavetable oscs,",
        "sub, noise, multi-",
        "mode filter, two",
        "envelopes, 2 LFOs,",
        "4-slot mod matrix,",
        "8 user macros.",
        "",
        "Based on Wavetable",
        "by Roland Rabien",
        "(FigBug), BSD-3."
      ]
    },
    {
      "title": "Wavetables",
      "lines": [
        "Tables live in",
        "UserLibrary/",
        " Wavetables.",
        "",
        "Drop .wav files",
        "there via Move",
        "Manager or the",
        "schwung manager.",
        "",
        "Serum, Vital and",
        "Ableton exports",
        "work (frame size",
        "auto-detected).",
        "",
        "115 factory tables",
        "are seeded on",
        "first run.",
        "",
        "On the OSC page,",
        "turn knobs 1/2 to",
        "step tables, or",
        "click to browse",
        "with live preview."
      ]
    },
    {
      "title": "Pages",
      "lines": [
        "Jog: next page.",
        "Shift+jog: next",
        " section.",
        "",
        "OSC: tables, pos,",
        " level, tune",
        "UNISON: voices,",
        " detune, spread",
        "SHAPE: bend and",
        " formant, sub tune",
        "FILTER: cutoff,",
        " res, EG amt, type,",
        " sub + noise",
        "ENV: amp + filter",
        " envelopes",
        "ENV+: velocity,",
        " key/vel tracking",
        "LFO 1/2: shape,",
        " rate, sync, depth",
        "MOD: 4 slots of",
        " src > dest > amt",
        "GLOBAL: poly/mono,",
        " glide, volume",
        "USER: 8 macros",
        "U.MAP: macro",
        " targets"
      ]
    },
    {
      "title": "User Macros",
      "lines": [
        "8 knobs you map",
        "to anything.",
        "",
        "On U.MAP, pick a",
        "target for each",
        "macro. On USER,",
        "play them.",
        "",
        "In Tablor's own",
        "editor: hold Shift",
        "and turn a knob on",
        "the USER page to",
        "assign directly.",
        "",
        "Macros save with",
        "the patch and can",
        "be automated."
      ]
    },
    {
      "title": "Presets",
      "lines": [
        "8 factory presets:",
        "",
        "Init",
        "First Contact",
        "Neu Bass",
        "Formant Keys",
        "Dust Pad",
        "Sub Punch",
        "Glass Bells",
        "Wobble",
        "",
        "Browse them from",
        "the slot's preset",
        "screen. Your own",
        "sounds save as",
        "module presets."
      ]
    },
    {
      "title": "MIDI",
      "lines": [
        "Notes, velocity,",
        "pitch bend (range",
        "on GLOBAL page),",
        "mod wheel (CC 1),",
        "sustain (CC 64),",
        "aftertouch.",
        "",
        "Mod wheel, after-",
        "touch and pitch",
        "bend are also mod",
        "matrix sources."
      ]
    },
    {
      "title": "Credits",
      "lines": [
        "Sound engine after",
        "Wavetable + gin by",
        "Roland Rabien",
        "(BSD-3).",
        "",
        "Filter DSP:",
        "AudioFilter (MZTi).",
        "FLAC: dr_flac.",
        "Pink noise: Thomas",
        "Merchant (MIT).",
        "",
        "Wavetables:",
        "Adventure Kid",
        "(AKWF, public",
        "domain) and Neu",
        "KatalYst (free).",
        "",
        "Port for Schwung:",
        "athousanddetails."
      ]
    }
  ]
}
